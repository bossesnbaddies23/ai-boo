{
  "name": "ai-boo-monorepo",
  "version": "1.0.0",
  "description": "AI Boo Monorepo - AI Avatar Platform + Unchained Subscription Platform",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:ai-boo": "cd packages/ai-boo && npm run dev",
    "dev:unchained": "cd packages/unchained && npm run dev",
    "build:ai-boo": "cd packages/ai-boo && npm run build",
    "build:unchained": "cd packages/unchained && npm run build",
    "start:ai-boo": "cd packages/ai-boo && npm start",
    "start:unchained": "cd packages/unchained && npm start",
    "install": "npm install --workspaces"
  },
  "keywords": [
    "ai-avatar",
    "subscription",
    "membership",
    "authentication",
    "monetization"
  ],
  "author": "Bosses N Baddies",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0"
  }
}
